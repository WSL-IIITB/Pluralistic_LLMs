# ── Worldview Explorer — environment ─────────────────────────────────────────
# Copy to `.env` (or `.env.local`) and fill in. Every var is optional: with none
# set, the app runs the fully offline mock demo on a dark canvas (no basemap).

# Mapbox access token. When set, a Mapbox dark basemap renders UNDER the deck.gl
# columns. When unset, deck.gl draws on the dark canvas alone (still fully usable).
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Stream source: "mock" (default, offline demo) or "sse" (real backend).
VITE_WORLDVIEW_STREAM=mock

# Real backend SSE endpoint (used only when VITE_WORLDVIEW_STREAM=sse).
# Should accept ?q=<query>&depth=<n> and stream JSON WorldviewEvents (see
# src/lib/worldview/types.ts), one per SSE `data:` line, ending with `done`.
VITE_WORLDVIEW_API_URL=/api/worldview/stream

# Mock playback speed multiplier (1 = authored ~23s timeline; 0.5 = 2x faster).
VITE_MOCK_SPEED=1

# ── Data View — environment ──────────────────────────────────────────────────
# Data View has no mock mode (it's a single, parameterless bootstrap load of
# real government data, not a per-query stream) — it always hits the real
# backend. Stream source: "sse" (default, only supported value).
VITE_DATAVIEW_STREAM=sse

# Data View's SSE bootstrap endpoint. Takes no query params and streams JSON
# DataViewEvents (see src/lib/dataview/types.ts), one per SSE `data:` line,
# ending with `done`. REST recompute calls (prescription/sensitivity/budget)
# share this same host/port, derived by stripping the trailing "/stream".
VITE_DATAVIEW_API_URL=http://localhost:8001/api/dataview/stream
