# Copy to .env. By default (ALLOW_STUB_FALLBACK unset/false), a source with no
# credentials contributes ZERO posts (skipped, not faked), and a missing
# OPENAI_API_KEY fails the run with a clear error — this is a real-data-only
# configuration. Fill in credentials one at a time to bring each source online;
# set ALLOW_STUB_FALLBACK=true to restore the old zero-credential offline-demo
# behavior (every connector falls back to a deterministic stub) for local testing.

# ── OpenAI (LLM: NER fallback, geolocation, cluster labeling, deflection, synthesis) ──
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM (Claude via Azure AI Foundry) — select with ?provider=azure_anthropic ──
# Foundry's Claude endpoint is the Anthropic Messages API surface, reached via
# the `anthropic` SDK. Both the key and endpoint must be set for the provider
# to be usable. Not the default (see LLM_PROVIDER below).
#
# This is a company endpoint/key, not for public use -- if you own it, put the
# real values in your own untracked .env only, never here. If you don't own
# it, ask whoever does for access via proxy/ (see its README) instead: set
# AZURE_ANTHROPIC_ENDPOINT to the proxy's URL + "/claude" and
# AZURE_ANTHROPIC_API_KEY to the shared passphrase it hands out (the proxy
# swaps in the real key server-side).
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_DEPLOYMENT=claude-sonnet-4-5

# ── LLM (self-hosted Gemma, OpenAI-compatible) — select with ?provider=gemma_remote ──
# An internal, unauthenticated server -- the real address is deliberately not
# committed here. If you own it, put the real URL in your own untracked .env
# only (REMOTE_GEMMA_API_KEY can stay blank -- the server takes no auth). If
# you don't own it, ask whoever does for access via proxy/ (see its README)
# instead: set REMOTE_GEMMA_BASE_URL to the proxy's URL + "/gemma" and
# REMOTE_GEMMA_API_KEY to the shared passphrase it hands out. No working
# /v1/embeddings or web-search on this server either way — embed() falls back
# to a local model, research() returns empty findings.
REMOTE_GEMMA_BASE_URL=
REMOTE_GEMMA_API_KEY=
REMOTE_GEMMA_CHAT_MODEL=Firworks/gemma-4-26B-A4B-it-fp8

# ── Reddit (PRAW) — register a "script" app at https://www.reddit.com/prefs/apps ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=worldview-explorer/0.1 (by u/your-username)

# ── YouTube Data API v3 — create a key at https://console.cloud.google.com/apis/credentials ──
YOUTUBE_API_KEY=

# ── Stub behavior ─────────────────────────────────────────────────────────────
# true = every connector without credentials falls back to deterministic fixture
# data (old offline-demo behavior). false (default) = missing sources are
# skipped/contribute nothing real; a missing LLM key fails the run outright.
ALLOW_STUB_FALLBACK=false

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8080"]
HOST=0.0.0.0
PORT=8001
