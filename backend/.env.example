# Copy to .env. By default (ALLOW_STUB_FALLBACK unset/false), a source with no
# credentials contributes ZERO posts (skipped, not faked), and a missing
# OPENAI_API_KEY fails the run with a clear error — this is a real-data-only
# configuration. Fill in credentials one at a time to bring each source online;
# set ALLOW_STUB_FALLBACK=true to restore the old zero-credential offline-demo
# behavior (every connector falls back to a deterministic stub) for local testing.

# ── OpenAI (LLM: NER fallback, geolocation, cluster labeling, deflection, synthesis) ──
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Reddit (PRAW) — register a "script" app at https://www.reddit.com/prefs/apps ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=worldview-explorer/0.1 (by u/your-username)

# ── YouTube Data API v3 — create a key at https://console.cloud.google.com/apis/credentials ──
YOUTUBE_API_KEY=

# ── Stub behavior ─────────────────────────────────────────────────────────────
# true = every connector without credentials falls back to deterministic fixture
# data (old offline-demo behavior). false (default) = missing sources are
# skipped/contribute nothing real; a missing LLM key fails the run outright.
ALLOW_STUB_FALLBACK=false

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8080"]
HOST=0.0.0.0
PORT=8001
